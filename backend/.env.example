# --- Database (Postgres) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logaccess
# Default admin and viewer passwords (used for seeding on first boot)
ADMIN_PASSWORD=admin123
VIEWER_PASSWORD=viewer123

# --- Server ---
PORT=3001
HOST=0.0.0.0
# Base URL used when the mock provider generates "presigned" URLs
PUBLIC_URL=http://localhost:3001
# Comma-separated list of allowed CORS origins (or * for any)
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
# CHANGE THIS in production!
JWT_SECRET=dev-secret-change-me
# Token lifetime in seconds (default: 8h)
JWT_EXPIRES_IN=28800

# --- Storage provider: mock | aws | gcp | azure ---
STORAGE_PROVIDER=mock
MOCK_DATA_DIR=./mock-data

# Presigned URL expiry limits (seconds)
PRESIGN_DEFAULT_EXPIRES_IN=3600
PRESIGN_MAX_EXPIRES_IN=86400

# --- AWS S3 (STORAGE_PROVIDER=aws) ---
AWS_REGION=us-east-1
AWS_BUCKET=your-log-bucket
# Optional: rely on the default AWS credential chain (env vars, shared config, IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional: custom endpoint for S3-compatible storage (e.g. LocalStack/MinIO)
# AWS_ENDPOINT=http://localhost:4566

# --- GCP GCS (STORAGE_PROVIDER=gcp) ---
GCP_BUCKET=your-log-bucket
# GCP_PROJECT_ID=
# GCP_KEY_FILENAME=/path/to/service-account.json
# Or use GOOGLE_APPLICATION_CREDENTIALS env var

# --- Azure Blob Storage (STORAGE_PROVIDER=azure) ---
AZURE_CONTAINER=your-log-container
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net